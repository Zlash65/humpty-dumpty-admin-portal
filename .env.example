# Postgres connection string (Neon / any Postgres provider)
# Example (Neon):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require
DATABASE_URL=REPLACE_ME

# Admin credentials (seeded on boot)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
ADMIN_PASSWORD_FORCE_UPDATE=0

# Auth/session signing secret (generate a long random value)
AUTH_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
