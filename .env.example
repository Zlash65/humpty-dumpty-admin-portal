# Option A (recommended): single MongoDB connection string
# MONGODB_URI=mongodb://localhost:27017/humpty-dumpty-school

# Option B: build MongoDB connection string from parts (e.g. Atlas)
MONGO_DB_PROTOCOL=mongodb+srv
MONGO_DB_USERNAME=REPLACE_ME
MONGO_DB_PASSWORD=REPLACE_ME
MONGO_DB_HOST=REPLACE_ME.mongodb.net
MONGO_DB_NAME=humpty-dumpty-data
MONGO_DB_OPTIONS=?retryWrites=true&w=majority

# Admin credentials (seeded on boot)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# Auth/session signing secret (generate a long random value)
AUTH_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
